# Component-level project: Analysis & Synthesis, not a board-programming design.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY column_sum_buffer
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SYSTEMVERILOG_FILE rtl/column_sum_buffer.sv
set_global_assignment -name SDC_FILE constraints/column_sum_buffer.sdc
# Defaults in RTL: K=11, PIXEL_W=8.
# Physical pin assignments intentionally absent until board integration.
