# Standalone left-column/valid alignment. Analysis & Synthesis, not a board top.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY left_column_delay
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SYSTEMVERILOG_FILE rtl/left_column_delay.sv
set_global_assignment -name SDC_FILE constraints/column_sum_buffer.sdc
